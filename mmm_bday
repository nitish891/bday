                vkSealedState.classList.remove('hidden');
            }, 400);
        });

        // Voice Note Player Simulation
        vkAudioPlayBtn.addEventListener('click', () => {
            getAudioContext();
            if (!isVkAudioPlaying) {
                isVkAudioPlaying = true;
                vkPlayIcon.setAttribute('data-lucide', 'pause');
                lucide.createIcons();
                vkAudioStatus.innerText = "Playing audio chord sequence...";
                
                let notes = [523.25, 659.25, 783.99, 1046.50];
                let noteIndex = 0;
                
                vkAudioInterval = setInterval(() => {
                    playChime(notes[noteIndex % notes.length], 0);
                    noteIndex++;

                    Array.from(vkEqBars).forEach(bar => {
                        const h = Math.floor(Math.random() * 20) + 6;
