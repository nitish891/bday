                });
            }

            // 4. Transform Vault UI & Reveal Vishrut Kote
            vkSealedState.classList.add('hidden');
            vkJumpscareBanner.classList.remove('hidden');

            if (typeof gsap !== 'undefined') {
                gsap.to(vkJumpscareBanner, {
                    scale: 1,
