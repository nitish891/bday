        }

        vkTriggerJumpscareBtn.addEventListener('click', triggerJumpscareSequence);

        vkReTriggerBtn.addEventListener('click', () => {
            if (isVkAudioPlaying) vkAudioPlayBtn.click();
            vkUnsealedLetter.classList.add('opacity-0');
            setTimeout(() => {
                vkUnsealedLetter.classList.add('hidden');
