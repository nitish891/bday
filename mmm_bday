    <!-- JAVASCRIPT LOGIC -->
    <script>
        lucide.createIcons();

        /* --- CURSOR STARBURST CANVAS --- */
        const cursorCanvas = document.getElementById('cursorCanvas');
        const cCtx = cursorCanvas.getContext('2d');
        let cursorParticles = [];
        
        function resizeCursorCanvas() {
            cursorCanvas.width = window.innerWidth;
            cursorCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCursorCanvas);
        resizeCursorCanvas();

        window.addEventListener('mousemove', (e) => {
            for (let i = 0; i < 2; i++) {
                cursorParticles.push({
                    x: e.clientX,
                    y: e.clientY,
                    size: Math.random() * 3 + 1,
                    vx: (Math.random() - 0.5) * 1.5,
                    vy: (Math.random() - 0.5) * 1.5 - 0.5,
                    alpha: 1,
                    color: Math.random() > 0.5 ? '#d4af37' : '#fff7d6'
                });
            }
        });

        function animateCursorParticles() {
            cCtx.clearRect(0, 0, cursorCanvas.width, cursorCanvas.height);
            cursorParticles.forEach((p, idx) => {
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= 0.02;
                p.size *= 0.96;

                cCtx.beginPath();
                cCtx.arc(p.x, p.y, Math.max(p.size, 0), 0, Math.PI * 2);
                cCtx.fillStyle = p.color;
                cCtx.globalAlpha = Math.max(p.alpha, 0);
                cCtx.shadowBlur = 8;
                cCtx.shadowColor = p.color;
                cCtx.fill();

                if (p.alpha <= 0) cursorParticles.splice(idx, 1);
            });
            cCtx.globalAlpha = 1;
            requestAnimationFrame(animateCursorParticles);
        }
        animateCursorParticles();

        /* --- AMBIENT PARTICLES --- */
        const canvas = document.getElementById('ambientCanvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            initParticles();
        });

        class Particle {
            constructor() { this.reset(); }
            reset() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.size = Math.random() * 2.5 + 0.5;
                this.speedY = -(Math.random() * 0.4 + 0.1);
                this.speedX = (Math.random() - 0.5) * 0.3;
                this.opacity = Math.random() * 0.6 + 0.2;
            }
            update() {
                this.y += this.speedY;
                this.x += this.speedX;
                if (this.y < 0) { this.reset(); this.y = height + 10; }
            }
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(212, 175, 55, ${this.opacity})`;
                ctx.shadowBlur = 6;
                ctx.shadowColor = '#d4af37';
                ctx.fill();
            }
        }

        function initParticles() {
            particles = [];
            for (let i = 0; i < Math.floor((width * height) / 12000); i++) {
                particles.push(new Particle());
            }
        }
        function animateParticles() {
            ctx.clearRect(0, 0, width, height);
            particles.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animateParticles);
        }
        initParticles();
        animateParticles();


        /* --- AUDIO SYNTHESIZER --- */
        let audioCtx = null;
        let isMusicPlaying = false;
        let musicInterval = null;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playChime(freq = 554.37, delay = 0) {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime + delay;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, now);

                gain.gain.setValueAtTime(0.001, now);
                gain.gain.exponentialRampToValueAtTime(0.2, now + 0.04);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.5);

                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 1.6);
            } catch(e){}
        }

        // Cork Pop sound effect synthesizer
        function playCorkPop() {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(120, now);
                osc.frequency.exponentialRampToValueAtTime(450, now + 0.05);

                gain.gain.setValueAtTime(0.5, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.09);
            } catch(e){}
        }

        // Deep Bass Drop + High Sting for Jumpscare
        function playJumpscareSound() {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;

                // Bass Drop
                const bassOsc = ctx.createOscillator();
                const bassGain = ctx.createGain();
                bassOsc.type = 'sawtooth';
                bassOsc.frequency.setValueAtTime(280, now);
                bassOsc.frequency.exponentialRampToValueAtTime(35, now + 0.65);
                bassGain.gain.setValueAtTime(0.7, now);
                bassGain.gain.exponentialRampToValueAtTime(0.001, now + 0.7);
                bassOsc.connect(bassGain);
                bassGain.connect(ctx.destination);
                bassOsc.start(now);
                bassOsc.stop(now + 0.7);

                // High Chime Blast Sequence after drop
                setTimeout(() => {
                    playChime(1046.50, 0);
                    playChime(1318.51, 0.1);
                    playChime(1567.98, 0.2);
                }, 200);

            } catch(e){}
        }

        // Background Music Synth
        const musicBoxBtn = document.getElementById('musicBoxBtn');
        const musicIcon = document.getElementById('musicIcon');
        const musicText = document.getElementById('musicText');
        const sparkleTrigger = document.getElementById('sparkleTrigger');
        const champagneBtn = document.getElementById('champagneBtn');

        musicBoxBtn.addEventListener('click', () => {
            getAudioContext();
            if (!isMusicPlaying) {
                isMusicPlaying = true;
                musicText.innerText = "Music Box: On";
                musicIcon.classList.add('animate-spin');

                let notes = [440, 554.37, 659.25, 880, 659.25, 554.37];
                let noteIdx = 0;

                musicInterval = setInterval(() => {
                    playChime(notes[noteIdx % notes.length], 0);
                    noteIdx++;
                }, 450);
            } else {
                isMusicPlaying = false;
                musicText.innerText = "Music Box: Off";
                musicIcon.classList.remove('animate-spin');
                clearInterval(musicInterval);
            }
        });

        sparkleTrigger.addEventListener('click', () => {
            playChime(880, 0);
            playChime(1046.50, 0.1);
            if (typeof confetti === 'function') confetti({ particleCount: 50, spread: 60, origin: { y: 0.2 } });
        });

        champagneBtn.addEventListener('click', () => {
            playCorkPop();
            setTimeout(() => {
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 120,
                        spread: 90,
                        origin: { y: 0.7 },
                        colors: ['#d4af37', '#fff7d6', '#e7bf47']
                    });
                }
            }, 50);
        });

        /* --- VISHRUT KOTE JUMPSCARE REVEAL LOGIC --- */
        const vkTriggerJumpscareBtn = document.getElementById('vkTriggerJumpscareBtn');
        const vkSealedState = document.getElementById('vkSealedState');
        const vkJumpscareBanner = document.getElementById('vkJumpscareBanner');
        const vkUnsealedLetter = document.getElementById('vkUnsealedLetter');
        const flashOverlay = document.getElementById('flashOverlay');
        const appBody = document.getElementById('appBody');
        const vkReTriggerBtn = document.getElementById('vkReTriggerBtn');
        const vkAudioPlayBtn = document.getElementById('vkAudioPlayBtn');
        const vkPlayIcon = document.getElementById('vkPlayIcon');
        const vkAudioStatus = document.getElementById('vkAudioStatus');
        const vkEqBars = document.getElementById('vkEqBars').children;
        let isVkAudioPlaying = false;
        let vkAudioInterval = null;

        function triggerJumpscareSequence() {
            // 1. Play Sound Shock
            playJumpscareSound();

            // 2. Screen Flash & Shake
            flashOverlay.style.opacity = '0.95';
            appBody.classList.add('animate-shake');

            setTimeout(() => {
                flashOverlay.style.opacity = '0';
