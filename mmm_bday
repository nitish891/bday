                        bar.classList.add('bg-gold-400');
                    });
                }, 300);

            } else {
                isVkAudioPlaying = false;
                clearInterval(vkAudioInterval);
                vkPlayIcon.setAttribute('data-lucide', 'play');
                lucide.createIcons();
                vkAudioStatus.innerText = "Tap play to listen to audio melody";
                
                Array.from(vkEqBars).forEach(bar => {
                    bar.style.height = '12px';
                    bar.classList.remove('bg-gold-400');
                });
            }
        });


        /* --- HYPER-REALISTIC PROCEDURAL FLAME & VOLUMETRIC SMOKE ENGINE --- */
        const flameCanvas = document.getElementById('flameCanvas');
        const fCtx = flameCanvas.getContext('2d');
        flameCanvas.width = 192;
        flameCanvas.height = 192;

        let flameActive = true;
        let windIntensity = 0; // Wind / Breath velocity factor (0 to 1)
        let flameParticles = [];
        let realisticSmoke = [];
        let micStream = null;
        let micAnalyser = null;
        let micDataArray = null;

        // Breath Audio Sound Synth
        function playBreathPuffSound() {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;
                const bufferSize = ctx.sampleRate * 0.4;
                const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1; // White noise
                }

                const noise = ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(300, now);
                filter.frequency.linearRampToValueAtTime(150, now + 0.4);

                const gain = ctx.createGain();
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(ctx.destination);
                noise.start(now);
            } catch(e){}
        }

        // Render Procedural Realistic Flame Particles & Halo Glow
        function renderFlameEngine() {
            fCtx.clearRect(0, 0, 192, 192);

            const centerX = 96;
            const baseY = 150;

            if (flameActive) {
                // 1. Dynamic Outer Radial Light Halo Glow
                const haloRadius = 45 + Math.random() * 6 - (windIntensity * 20);
                const haloGrad = fCtx.createRadialGradient(centerX, baseY - 25, 2, centerX, baseY - 25, Math.max(haloRadius, 5));
                haloGrad.addColorStop(0, 'rgba(255, 180, 50, 0.4)');
                haloGrad.addColorStop(0.5, 'rgba(212, 175, 55, 0.15)');
                haloGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');

                fCtx.fillStyle = haloGrad;
                fCtx.beginPath();
                fCtx.arc(centerX, baseY - 25, Math.max(haloRadius, 5), 0, Math.PI * 2);
                fCtx.fill();

                // 2. Generate Micro Flame Core Particles
                const particleCount = Math.floor(6 - windIntensity * 3);
                for (let i = 0; i < particleCount; i++) {
                    flameParticles.push({
                        x: centerX + (Math.random() - 0.5) * 4,
                        y: baseY,
                        vx: (Math.random() - 0.5) * 0.8 + (windIntensity * 4.5), // Lean sideways when blowing
                        vy: -(Math.random() * 2.5 + 2) * (1 - windIntensity * 0.5),
                        size: Math.random() * 12 + 10,
                        life: 1.0,
                        decay: Math.random() * 0.04 + 0.03
                    });
                }

                // 3. Render Flame Core Particles
                flameParticles.forEach((p, idx) => {
                    p.x += p.vx + (Math.random() - 0.5) * 0.5;
                    p.y += p.vy;
                    p.life -= p.decay;
                    p.size *= 0.94;

                    if (p.life <= 0 || p.size <= 0.5) {
                        flameParticles.splice(idx, 1);
                        return;
                    }

                    fCtx.save();
                    fCtx.beginPath();
                    fCtx.arc(p.x, p.y, Math.max(p.size, 0.1), 0, Math.PI * 2);

                    // Multi-layer Color Gradient (Hot Blue Base -> Amber Middle -> Yellow Aura)
                    const pGrad = fCtx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
                    if (p.life > 0.75) {
                        pGrad.addColorStop(0, 'rgba(255, 255, 250, 0.95)');
                        pGrad.addColorStop(0.4, 'rgba(255, 200, 50, 0.8)');
                        pGrad.addColorStop(1, 'rgba(255, 100, 0, 0)');
                    } else if (p.life > 0.35) {
                        pGrad.addColorStop(0, 'rgba(255, 180, 40, 0.9)');
                        pGrad.addColorStop(0.6, 'rgba(212, 140, 20, 0.5)');
                        pGrad.addColorStop(1, 'rgba(180, 50, 0, 0)');
                    } else {
                        pGrad.addColorStop(0, 'rgba(100, 150, 255, 0.6)'); // Hot blue base rim
                        pGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
                    }

                    fCtx.fillStyle = pGrad;
                    fCtx.fill();
                    fCtx.restore();
                });

                // Hot Blue Wick Base Dot
                fCtx.fillStyle = 'rgba(80, 160, 255, 0.9)';
                fCtx.beginPath();
                fCtx.arc(centerX, baseY - 2, 3, 0, Math.PI * 2);
                fCtx.fill();
            }

            // 4. Render Multi-Stage Volumetric Smoke Engine
            realisticSmoke.forEach((s, idx) => {
                s.x += s.vx + Math.sin(s.y * 0.05) * 0.6;
                s.y += s.vy;
                s.size += s.growth;
                s.alpha -= s.decay;

                if (s.alpha <= 0) {
                    realisticSmoke.splice(idx, 1);
                    return;
                }

                fCtx.save();
                fCtx.beginPath();
                fCtx.arc(s.x, s.y, Math.max(s.size, 0.1), 0, Math.PI * 2);

                const sGrad = fCtx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.size);
                sGrad.addColorStop(0, `rgba(220, 220, 230, ${s.alpha * 0.4})`);
                sGrad.addColorStop(0.5, `rgba(160, 160, 180, ${s.alpha * 0.2})`);
                sGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');

                fCtx.fillStyle = sGrad;
                fCtx.fill();
                fCtx.restore();
            });

            requestAnimationFrame(renderFlameEngine);
        }
        renderFlameEngine();

        // Spawn Dense Volumetric Smoke Stream
        function triggerVolumetricSmoke() {
            const centerX = 96;
            const baseY = 145;
            for (let i = 0; i < 45; i++) {
                realisticSmoke.push({
                    x: centerX + (Math.random() - 0.5) * 6,
                    y: baseY - Math.random() * 10,
                    vx: (Math.random() - 0.5) * 1.2 + (windIntensity * 2),
                    vy: -(Math.random() * 1.8 + 1.2),
                    size: Math.random() * 4 + 3,
                    growth: Math.random() * 0.25 + 0.12,
                    alpha: Math.random() * 0.7 + 0.3,
                    decay: Math.random() * 0.012 + 0.008
                });
            }
        }

        // Extinguish Flame Logic
        function blowOutCandleFlame() {
            if (!flameActive) return;
            flameActive = false;
            windIntensity = 0;

            playBreathPuffSound();
            triggerVolumetricSmoke();

            playChime(659.25, 0);
            playChime(880, 0.15);

            if (typeof confetti === 'function') {
                confetti({ particleCount: 90, spread: 75, origin: { y: 0.6 } });
            }

            setTimeout(() => {
                const wishMsg = document.getElementById('wishMessage');
                wishMsg.classList.remove('hidden');
                setTimeout(() => {
                    wishMsg.classList.remove('opacity-0');
                    wishMsg.classList.add('opacity-100');
                }, 50);
            }, 600);
        }

        // Mic Stream & Blow Detection
        const enableMicBtn = document.getElementById('enableMicBtn');
        const micBtnText = document.getElementById('micBtnText');
        const micMeterWrapper = document.getElementById('micMeterWrapper');
        const micMeterFill = document.getElementById('micMeterFill');

        enableMicBtn.addEventListener('click', async () => {
            getAudioContext();
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                alert("Microphone input is not supported in this browser. Please use the 'Click To Blow' button!");
                return;
            }

            try {
                micStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                const ctx = getAudioContext();
                const source = ctx.createMediaStreamSource(micStream);
                micAnalyser = ctx.createAnalyser();
                micAnalyser.fftSize = 256;
                source.connect(micAnalyser);
                micDataArray = new Uint8Array(micAnalyser.frequencyBinCount);

                micBtnText.innerText = "Mic Active • Blow Now! 🌬️";
                enableMicBtn.classList.add('border-gold-400', 'shadow-gold-glow');
                micMeterWrapper.classList.remove('hidden');

                // Process Mic Audio Level in Loop
                function processMicBlow() {
                    if (!flameActive) return;

                    micAnalyser.getByteFrequencyData(micDataArray);
                    let sum = 0;
                    for (let i = 0; i < micDataArray.length; i++) {
                        sum += micDataArray[i];
                    }
                    const average = sum / micDataArray.length;
                    const normalizedVolume = Math.min(average / 90, 1.0); // 0 to 1 scale

                    micMeterFill.style.width = `${normalizedVolume * 100}%`;

                    if (normalizedVolume > 0.15) {
                        windIntensity = normalizedVolume; // Lean flame sideways dynamically
                    } else {
                        windIntensity *= 0.85; // Smooth recovery
                    }

                    // High breath threshold to trigger extinguish
                    if (normalizedVolume > 0.65) {
                        blowOutCandleFlame();
                    } else {
                        requestAnimationFrame(processMicBlow);
                    }
                }
                processMicBlow();

            } catch(err) {
                console.error(err);
                micBtnText.innerText = "Mic Access Denied (Use Click)";
            }
        });

        // Click Fallback Triggers
        document.getElementById('cakeWrapper').addEventListener('click', blowOutCandleFlame);
        document.getElementById('blowCandleBtn').addEventListener('click', blowOutCandleFlame);

        // Reignite Flame Handler
        document.getElementById('reigniteBtn').addEventListener('click', () => {
            flameActive = true;
            windIntensity = 0;
            document.getElementById('wishMessage').classList.add('opacity-0');
            setTimeout(() => document.getElementById('wishMessage').classList.add('hidden'), 500);
        });

        /* --- 3D TILT TILE FLIP --- */
        function flipCard(element) {
            const inner = element.querySelector('.card-inner');
            inner.classList.toggle('rotate-y-180');
            playChime(700, 0);
        }

        document.querySelectorAll('.tilt-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.transform = `rotateY(${(x - rect.width/2)/15}deg) rotateX(${-(y - rect.height/2)/15}deg)`;
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = `rotateY(0deg) rotateX(0deg)`;
            });
        });
    </script>
</body>
</html>
